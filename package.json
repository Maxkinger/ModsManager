{
  "name": "mayfly-mod-manager-electron",
  "version": "0.1.0",
  "description": "Mayfly Mod Manager desktop application",
  "author": "Mayfly",
  "private": true,
  "type": "module",
  "main": "out/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "vue-tsc --noEmit && electron-vite build && node scripts/copy-resources.cjs",
    "dist": "npm run build && electron-builder --win",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit",
    "check:adapters": "node scripts/check-adapters.cjs"
  },
  "build": {
    "appId": "com.mayfly.modmanager",
    "productName": "Mayfly Mod Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mayfly Mod Manager"
    }
  },
  "dependencies": {
    "@types/adm-zip": "^0.5.8",
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.6.0",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
