{
  "name": "mayfly-mod-manager-electron",
  "version": "1.0.0",
  "description": "mayflyMods desktop application",
  "securityNotice": "b战：清梦与狗不得使用，其他人随意使用，不过分抄袭套壳即可",
  "author": "Mayfly",
  "private": true,
  "type": "module",
  "main": "out/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "node scripts/prepare-7zip-bin.cjs && vue-tsc --noEmit && electron-vite build && node scripts/copy-resources.cjs",
    "dist": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64 --x64",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit",
    "check:platform-paths": "node scripts/check-platform-paths.cjs",
    "check:platform-support": "node scripts/check-platform-support.cjs",
    "check:macos-path-safety": "node scripts/check-macos-path-safety.cjs",
    "check:7zip-packaging": "node scripts/check-7zip-packaging.cjs",
    "check:adapters": "node scripts/check-adapters.cjs",
    "check:adapter-rules": "node scripts/check-adapter-rules.cjs",
    "check:archive-import": "node scripts/check-archive-import-security.cjs",
    "check:install-safety": "node scripts/check-install-uninstall-safety.cjs",
    "check:import-flow": "node scripts/check-import-flow.cjs",
    "check:real-mod-folders": "node scripts/check-real-mod-folders.cjs",
    "check:all": "npm run typecheck && npm run check:platform-paths && npm run check:platform-support && npm run check:macos-path-safety && npm run check:7zip-packaging && npm run check:adapters && npm run check:adapter-rules && npm run check:archive-import && npm run check:install-safety && npm run check:import-flow && npm run check:real-mod-folders && npm run build"
  },
  "build": {
    "appId": "com.mayfly.modmanager",
    "productName": "mayflyMods",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/7zip-bin/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "mayflyMods"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.icns",
      "identity": null,
      "notarize": false,
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@types/adm-zip": "^0.5.8",
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.6.0",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.2.6",
    "undici": "^6.28.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
